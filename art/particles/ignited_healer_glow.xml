<?xml version="1.0" encoding="utf-8"?>
<particles>
	<texture>art/textures/particles/hero_aura.png</texture>
	<blend mode="add"/>

	<!-- Low emission rate = a sparse, less-dense glow. -->
	<constant name="emissionrate" value="18.0"/>
	<uniform name="lifetime" min="1.0" max="1.6"/>

	<!-- Emit in a small disc at the base (the helmet point, above the head),
	     then rise while fanning outward → an upward-opening cone that is
	     narrow/denser at the bottom and wider/softer at the top.
	     lifetime * velocity.y reaches ~0.8 units ≈ half a healer's height. -->
	<uniform name="position.x" min="-0.12" max="0.12"/>
	<uniform name="position.z" min="-0.12" max="0.12"/>
	<!-- Lift the emission above the head (the "back" point is mid-torso). -->
	<constant name="position.y" value="1.0"/>

	<uniform name="velocity.y" min="0.9" max="1.4"/>
	<uniform name="velocity.x" min="-0.35" max="0.35"/>
	<uniform name="velocity.z" min="-0.35" max="0.35"/>

	<uniform name="size" min="0.18" max="0.32"/>
	<constant name="size.growthRate" value="0.35"/>

	<!-- Soft warm healing light. -->
	<constant name="color.r" value="1.0"/>
	<constant name="color.g" value="0.92"/>
	<constant name="color.b" value="0.65"/>
</particles>
