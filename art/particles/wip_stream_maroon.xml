<?xml version="1.0" encoding="utf-8"?>
<particles>
	<texture>art/textures/particles/sparks.png</texture>
	<blend mode="add"/>

	<!-- Dense emission + near-zero velocity: particles stay where they
	     spawn while the projectile flies on, leaving a continuous stream
	     trailing behind the bolt rather than a single compact ball. -->
	<constant name="emissionrate" value="200.0"/>
	<uniform name="lifetime" min="0.35" max="0.6"/>

	<uniform name="angle" min="-0.6" max="0.6"/>

	<uniform name="velocity.x" min="-0.06" max="0.06"/>
	<uniform name="velocity.y" min="-0.06" max="0.06"/>
	<uniform name="velocity.z" min="-0.06" max="0.06"/>
	<uniform name="velocity.angle" min="-0.3" max="0.3"/>

	<uniform name="size" min="0.55" max="0.95"/>
	<!-- Taper so the trailing end thins into the stream. -->
	<constant name="size.growthRate" value="-1.2"/>

	<!-- Deep maroon. -->
	<constant name="color.r" value="0.45"/>
	<constant name="color.g" value="0.03"/>
	<constant name="color.b" value="0.1"/>
</particles>
