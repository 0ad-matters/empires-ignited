<?xml version="1.0" encoding="utf-8"?>
<particles>
	<texture>art/textures/particles/sparks.png</texture>
	<blend mode="add"/>

	<constant name="emissionrate" value="80.0"/>
	<uniform name="lifetime" min="0.25" max="0.45"/>

	<uniform name="angle" min="-0.6" max="0.6"/>

	<!-- Tight spread keeps the particles together as a cohesive bolt
	     rather than scattering like sparks. -->
	<uniform name="velocity.x" min="-0.12" max="0.12"/>
	<uniform name="velocity.y" min="-0.12" max="0.12"/>
	<uniform name="velocity.z" min="-0.12" max="0.12"/>
	<uniform name="velocity.angle" min="-0.4" max="0.4"/>

	<uniform name="size" min="0.7" max="1.3"/>

	<!-- Bright near-white cyan core. -->
	<constant name="color.r" value="0.6"/>
	<constant name="color.g" value="0.95"/>
	<constant name="color.b" value="1.0"/>
</particles>
