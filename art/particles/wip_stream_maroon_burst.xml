<?xml version="1.0" encoding="utf-8"?>
<particles>
	<texture>art/textures/particles/sparks.png</texture>
	<blend mode="add"/>

	<!-- Short outward splash where the stream lands. -->
	<constant name="emissionrate" value="120.0"/>
	<uniform name="lifetime" min="0.15" max="0.35"/>

	<uniform name="angle" min="-3.14" max="3.14"/>

	<uniform name="velocity.x" min="-1.6" max="1.6"/>
	<uniform name="velocity.y" min="-0.4" max="1.8"/>
	<uniform name="velocity.z" min="-1.6" max="1.6"/>
	<uniform name="velocity.angle" min="-1.0" max="1.0"/>

	<uniform name="size" min="0.5" max="1.1"/>
	<constant name="size.growthRate" value="-2.0"/>

	<constant name="color.r" value="0.5"/>
	<constant name="color.g" value="0.04"/>
	<constant name="color.b" value="0.12"/>
</particles>
